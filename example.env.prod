# ============================================================
# UpcycleConnect — Variables d'environnement de production
#
# Copier ce fichier en .env.prod et remplir toutes les valeurs
# AVANT de lancer docker-compose.prod.yml
#
# Générer APP_KEY : php artisan key:generate --show
# ============================================================

# MySQL
MYSQL_ROOT_PASSWORD=change_me_root_password
DB_USERNAME=uc_user
DB_PASSWORD=change_me_db_password

# Laravel
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate
APP_URL=http://your-domain.com

# Go API
JWT_SECRET=change_me_jwt_secret_key_minimum_32_chars

# ------------------------------------------------------------
# Stockage des médias (photos)
# ------------------------------------------------------------
# Par défaut (variables laissées vides) : stockage LOCAL servi par nginx
# au chemin /uploads — aucune configuration nécessaire.
#
# Pour un bucket S3-compatible (OVH, Scaleway, AWS, MinIO auto-hébergé),
# décommenter et remplir. STORAGE_DRIVER=s3 pour l'API Go, MEDIA_DISK=s3
# pour Laravel, et MEDIA_URL = URL publique du bucket (préfixe des photos).
#
# STORAGE_DRIVER=s3
# MEDIA_DISK=s3
# MEDIA_URL=https://mon-bucket.s3.exemple.com
# AWS_ACCESS_KEY_ID=change_me
# AWS_SECRET_ACCESS_KEY=change_me
# AWS_DEFAULT_REGION=gra
# AWS_BUCKET=upcycleconnect
# AWS_ENDPOINT=https://s3.gra.io.cloud.ovh.net
# AWS_URL=https://mon-bucket.s3.exemple.com
# AWS_USE_PATH_STYLE_ENDPOINT=false

# ------------------------------------------------------------
# Mail (SMTP) — envoi de vrais mails
# ------------------------------------------------------------
# En dev, MAIL_HOST=mailpit capture les mails sans les envoyer. En prod, pointer
# vers le serveur mail réel : soit le serveur mail DMZ de la mission 2, soit un
# relais SMTP validé. MAIL_ENCRYPTION : "starttls" (port 587) ou "ssl" (port 465)
# ou vide (interne sans TLS). MAIL_USERNAME/PASSWORD activent l'authentification.
# MAIL_HOST=mail.upcycleconnect.fr
# MAIL_PORT=587
# MAIL_FROM=noreply@upcycleconnect.fr
# MAIL_USERNAME=noreply@upcycleconnect.fr
# MAIL_PASSWORD=your_smtp_password
# MAIL_ENCRYPTION=starttls

# ------------------------------------------------------------
# Notifications push OneSignal
# ------------------------------------------------------------
# Laisser vide = push désactivé (aucun envoi, client web non initialisé).
# App ID : exposé au navigateur (client web). API Key : REST API Key OneSignal,
# reste côté API Go pour l'envoi. App mobile Kotlin : même App ID + login(userId).
# ONESIGNAL_APP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# ONESIGNAL_API_KEY=your_onesignal_rest_api_key

# ------------------------------------------------------------
# GLPI — miroir des tickets d'incident
# ------------------------------------------------------------
# Laisser vide = miroir désactivé (les tickets restent dans l'app uniquement).
# Renseigner après avoir déployé GLPI, activé l'API REST et généré les jetons.
# GLPI_URL=https://glpi.mondomaine.fr/apirest.php
# GLPI_APP_TOKEN=your_glpi_app_token
# GLPI_USER_TOKEN=your_glpi_user_token
